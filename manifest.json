{
  "manifest_version": 3,
  "name": "Sales HUD - LinkedIn Caller Intelligence",
  "version": "1.0.0",
  "description": "Real-time local time, call status, and lead intelligence HUD for LinkedIn profiles.",
  "permissions": ["storage", "clipboardWrite", "activeTab", "scripting"],
  "host_permissions": ["*://*.linkedin.com/*"],
  "content_scripts": [
    {
      "matches": ["*://*.linkedin.com/*"],
      "js": ["src/timezone-map.js", "src/scraper.js", "src/hud.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": "icons/icon48.png",
    "default_title": "Sales HUD",
    "default_popup": "popup/popup.html"
  }
}
